# ─────────────────────────────────────────────────────────────
# KoW Tracker - Конфигурация переменных окружения
# ─────────────────────────────────────────────────────────────

# Режим работы приложения: production / development
NODE_ENV=production

# Порт приложения на хост-машине (по умолчанию 3000)
PORT=3000

# IP-интерфейс для привязки:
# 0.0.0.0   - доступен со всех интерфейсов (прямой доступ)
# 127.0.0.1 - доступен только локально (рекомендуется при использовании Nginx Reverse Proxy)
BIND_IP=0.0.0.0

# Путь к файлу базы данных SQLite внутри контейнера
DB_PATH=/app/data/kow.db

# ─────────────────────────────────────────────────────────────
# Синхронизация базы данных с S3-хранилищем (Опционально)
# Обязательно для stateless облачных платформ (Timeweb Cloud Apps / Heroku / Render).
# Если переменные не заданы, база данных сохраняется только локально на диске.
# ─────────────────────────────────────────────────────────────
# S3_ENDPOINT=s3.timeweb.cloud
# S3_BUCKET=kow-data
# S3_ACCESS_KEY=your_access_key_here
# S3_SECRET_KEY=your_secret_key_here
# S3_REGION=ru-1
# S3_KEY=kow.db
# S3_SYNC_INTERVAL_MS=5000
